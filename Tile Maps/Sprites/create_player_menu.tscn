[gd_scene format=3 uid="uid://create_player_menu"]

[ext_resource type="Script" path="res://create_player_menu.gd" id="1_script"]

[node name="CreatePlayerMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

; ── Tytuł ──────────────────────────────────────────────────────────────
[node name="TitleLabel" type="Label" parent="."]
layout_mode = 0
offset_left = 320.0
offset_top = 18.0
offset_right = 680.0
offset_bottom = 50.0
horizontal_alignment = 1
text = "✦ Stwórz Postać ✦"
theme_override_font_sizes/font_size = 24

; ── Panel podglądu postaci ─────────────────────────────────────────────
[node name="PreviewPanel" type="Panel" parent="."]
layout_mode = 0
offset_left = 480.0
offset_top = 70.0
offset_right = 720.0
offset_bottom = 420.0

[node name="PreviewContainer" type="Control" parent="PreviewPanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="LayerSkin" type="ColorRect" parent="PreviewPanel/PreviewContainer"]
layout_mode = 0
offset_left = 70.0
offset_top = 50.0
offset_right = 170.0
offset_bottom = 300.0
color = Color(1, 0.85, 0.7, 1)

[node name="LayerHair" type="TextureRect" parent="PreviewPanel/PreviewContainer"]
layout_mode = 0
offset_left = 70.0
offset_top = 50.0
offset_right = 170.0
offset_bottom = 300.0
expand_mode = 1

[node name="LayerClothes" type="TextureRect" parent="PreviewPanel/PreviewContainer"]
layout_mode = 0
offset_left = 70.0
offset_top = 50.0
offset_right = 170.0
offset_bottom = 300.0
expand_mode = 1

[node name="LayerHat" type="TextureRect" parent="PreviewPanel/PreviewContainer"]
layout_mode = 0
offset_left = 70.0
offset_top = 50.0
offset_right = 170.0
offset_bottom = 300.0
expand_mode = 1

; ── Panel opcji (VBox) ─────────────────────────────────────────────────
[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 0
offset_left = 60.0
offset_top = 70.0
offset_right = 460.0
offset_bottom = 520.0
theme_override_constants/separation = 12

; Nazwa świata
[node name="WorldNameEdit" type="LineEdit" parent="VBox"]
placeholder_text = "Nazwa Świata"
max_length = 24

; Nazwa gracza
[node name="PlayerNameEdit" type="LineEdit" parent="VBox"]
placeholder_text = "Nick Gracza"
max_length = 20

; ─── Kolor skóry ───────────────────────────────────────────────────────
[node name="SkinRow" type="HBoxContainer" parent="VBox"]
[node name="SkinPrev" type="Button" parent="VBox/SkinRow"]
text = "◀"
[node name="SkinLabel" type="Label" parent="VBox/SkinRow"]
text = "Skin 1 / 5"
size_flags_horizontal = 3
horizontal_alignment = 1
[node name="SkinNext" type="Button" parent="VBox/SkinRow"]
text = "▶"

; ─── Styl włosów ───────────────────────────────────────────────────────
[node name="HairStyleRow" type="HBoxContainer" parent="VBox"]
[node name="HairStylePrev" type="Button" parent="VBox/HairStyleRow"]
text = "◀"
[node name="HairStyleLabel" type="Label" parent="VBox/HairStyleRow"]
text = "Style 1 / 3"
size_flags_horizontal = 3
horizontal_alignment = 1
[node name="HairStyleNext" type="Button" parent="VBox/HairStyleRow"]
text = "▶"

; ─── Kolor włosów ──────────────────────────────────────────────────────
[node name="HairColorRow" type="HBoxContainer" parent="VBox"]
[node name="HairColorPrev" type="Button" parent="VBox/HairColorRow"]
text = "◀"
[node name="HairColorLabel" type="Label" parent="VBox/HairColorRow"]
text = "Color 1 / 7"
size_flags_horizontal = 3
horizontal_alignment = 1
[node name="HairColorNext" type="Button" parent="VBox/HairColorRow"]
text = "▶"

; ─── Ubranie ───────────────────────────────────────────────────────────
[node name="ClothesRow" type="HBoxContainer" parent="VBox"]
[node name="ClothesPrev" type="Button" parent="VBox/ClothesRow"]
text = "◀"
[node name="ClothesLabel" type="Label" parent="VBox/ClothesRow"]
text = "Outfit 1 / 3"
size_flags_horizontal = 3
horizontal_alignment = 1
[node name="ClothesNext" type="Button" parent="VBox/ClothesRow"]
text = "▶"

; ─── Kapelusze ─────────────────────────────────────────────────────────
[node name="HatRow" type="HBoxContainer" parent="VBox"]
[node name="HatPrev" type="Button" parent="VBox/HatRow"]
text = "◀"
[node name="HatLabel" type="Label" parent="VBox/HatRow"]
text = "No hat"
size_flags_horizontal = 3
horizontal_alignment = 1
[node name="HatNext" type="Button" parent="VBox/HatRow"]
text = "▶"

; ── Błąd ───────────────────────────────────────────────────────────────
[node name="ErrorLabel" type="Label" parent="."]
layout_mode = 0
offset_left = 60.0
offset_top = 530.0
offset_right = 460.0
offset_bottom = 556.0
modulate = Color(1, 0.3, 0.3, 1)

; ── Przyciski akcji ────────────────────────────────────────────────────
[node name="CreateButton" type="Button" parent="."]
layout_mode = 0
offset_left = 60.0
offset_top = 560.0
offset_right = 260.0
offset_bottom = 592.0
text = "✦ Stwórz Świat"

[node name="BackButton" type="Button" parent="."]
layout_mode = 0
offset_left = 270.0
offset_top = 560.0
offset_right = 460.0
offset_bottom = 592.0
text = "◀ Wstecz"

; ── Połączenia sygnałów ────────────────────────────────────────────────
[connection signal="pressed" from="VBox/SkinRow/SkinPrev"           to="."  method="_on_skin_prev_pressed"]
[connection signal="pressed" from="VBox/SkinRow/SkinNext"           to="."  method="_on_skin_next_pressed"]
[connection signal="pressed" from="VBox/HairStyleRow/HairStylePrev" to="."  method="_on_hair_style_prev_pressed"]
[connection signal="pressed" from="VBox/HairStyleRow/HairStyleNext" to="."  method="_on_hair_style_next_pressed"]
[connection signal="pressed" from="VBox/HairColorRow/HairColorPrev" to="."  method="_on_hair_color_prev_pressed"]
[connection signal="pressed" from="VBox/HairColorRow/HairColorNext" to="."  method="_on_hair_color_next_pressed"]
[connection signal="pressed" from="VBox/ClothesRow/ClothesPrev"     to="."  method="_on_clothes_prev_pressed"]
[connection signal="pressed" from="VBox/ClothesRow/ClothesNext"     to="."  method="_on_clothes_next_pressed"]
[connection signal="pressed" from="VBox/HatRow/HatPrev"             to="."  method="_on_hat_prev_pressed"]
[connection signal="pressed" from="VBox/HatRow/HatNext"             to="."  method="_on_hat_next_pressed"]
[connection signal="pressed" from="CreateButton"                    to="."  method="_on_create_button_pressed"]
[connection signal="pressed" from="BackButton"                      to="."  method="_on_back_button_pressed"]
